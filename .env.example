# Copie para .env e preencha os valores. Nunca versione o .env.
SPRING_PROFILES_ACTIVE=local

DB_HOST=localhost
DB_PORT=5432
DB_NAME=mecano
DB_USERNAME=mecano
DB_PASSWORD=

# Segredo HMAC para assinar os tokens JWT (mínimo de 32 caracteres).
JWT_SECRET=
# Validade do token no formato ISO-8601 (ex.: PT1H = 1 hora).
JWT_EXPIRATION=PT1H

# Administrador criado na primeira subida (deixe vazio para não criar).
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@mecano.local
ADMIN_PASSWORD=

APP_PORT=8080

# Para popular a base com dados de demonstração, use SPRING_PROFILES_ACTIVE=local,demo.
# Senha dos usuários de demonstração (atendente, mecanico e estoque @mecano.local).
DEMO_PASSWORD=demo-mecano
