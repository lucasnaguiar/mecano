# Valores padrão para execução local. O docker-compose e o perfil local já usam estes valores sem nenhum .env:
# copie para .env só se quiser alterar algum. Não use estes valores fora da máquina local e nunca versione o .env.

# Perfis: local (padrão de desenvolvimento) e demo (cria equipe e dados de demonstração na primeira subida).
SPRING_PROFILES_ACTIVE=local,demo

# PostgreSQL. No docker-compose a aplicação usa o host interno "postgres"; DB_PORT é a porta publicada na máquina.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mecano
DB_USERNAME=mecano
DB_PASSWORD=mecano

# Segredo HMAC para assinar os tokens JWT (mínimo de 32 caracteres).
JWT_SECRET=mecano-segredo-local-somente-para-desenvolvimento
# Validade do token no formato ISO-8601 (ex.: PT1H = 1 hora).
JWT_EXPIRATION=PT1H

# Administrador criado na primeira subida.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@mecano.local
ADMIN_PASSWORD=admin-mecano

# Senha dos usuários de demonstração (atendente, mecanico e estoque @mecano.local), criados pelo perfil demo.
DEMO_PASSWORD=demo-mecano

# Porta da aplicação publicada pelo docker-compose.
APP_PORT=8080

# Limite por IP e por minuto no login e na consulta pelo código de acompanhamento.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_TRACKING=30
